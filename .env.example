# Copy to .env in the repository root (make setup does this for you).
# Python reads it directly; `make java` loads it for the Java worker too.

# ============================================================================
# LLM: any LangChain chat model that supports tool calling
# ============================================================================
# Default: Claude through langchain-anthropic.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Other providers: change the two lines above, add that provider's credentials,
# then run `make setup` again to install its LangChain package. Examples:
#
#   OpenAI:          LLM_PROVIDER=openai          LLM_MODEL=gpt-4.1          OPENAI_API_KEY=...
#   Azure OpenAI:    LLM_PROVIDER=azure_openai    LLM_MODEL=<model>          AZURE_OPENAI_API_KEY=...
#                    AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com  OPENAI_API_VERSION=<version>
#                    LLM_KWARGS='{"azure_deployment": "<your deployment name>"}'
#   Ollama (local):  LLM_PROVIDER=ollama          LLM_MODEL=llama3.1
#   OpenAI-compatible server (vLLM, LM Studio, LiteLLM, ...):
#                    LLM_PROVIDER=openai          LLM_MODEL=<model>          LLM_BASE_URL=http://localhost:8001/v1
#                    OPENAI_API_KEY=<any value, if your server doesn't check it>
#   Amazon Bedrock:  LLM_PROVIDER=bedrock_converse  LLM_MODEL=<model id>   (uses your AWS credentials and region)
#   Gemini:          LLM_PROVIDER=google_genai    LLM_MODEL=<model>          GOOGLE_API_KEY=...

# Optional for any provider:
LLM_BASE_URL=
LLM_MAX_TOKENS=1500
# Leave unset to use the model's default; some models reject other values.
LLM_TEMPERATURE=
# Provider-specific keyword arguments for the LangChain chat model, as JSON in single quotes.
LLM_KWARGS=

# Default model mode in the console: live (the LLM above) or mock (Scripted).
LLM_MODE=live

# ============================================================================
# Temporal (the defaults match the local dev server started by `make temporal`)
# ============================================================================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_UI_URL=http://localhost:8233
# Pointing TEMPORAL_ADDRESS anywhere else (self-hosted or Temporal Cloud) makes
# `make up` skip the local dev server. Authentication, if your service needs it:
#
#   Temporal Cloud, API key:   TEMPORAL_API_KEY=...
#   mTLS (Cloud or self-hosted): TEMPORAL_TLS_CERT=path/to/client.pem  TEMPORAL_TLS_KEY=path/to/client.key
#   Self-hosted, private CA:   TEMPORAL_TLS_CA=path/to/ca.pem   (alone for server TLS, or with the mTLS pair)
#   Self-hosted, TLS with a public CA and no client certificate: TEMPORAL_TLS=true
# Relative paths are relative to this file.
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=
TEMPORAL_TLS_CA=
TEMPORAL_TLS=
# Python only: override the server name checked against the certificate.
TEMPORAL_TLS_SERVER_NAME=

# ============================================================================
# Demo services
# ============================================================================
MCP_BASE_URL=http://localhost:8765
API_HOST=127.0.0.1
API_PORT=8000
# Only when serving the console from a different origin than the API (not needed
# for the normal setup). Comma-separated, e.g. https://console.example.com
CORS_ORIGINS=
